#!/bin/sh
# Keeps the "playground-assets" GitHub release (private example art/audio
# consumed by .github/workflows/deploy-pages.yml) in sync with whatever
# is on disk. Never blocks the push — sync-playground-assets.mjs already
# swallows its own errors, this is just a second layer of defense.
node "$(git rev-parse --show-toplevel)/scripts/sync-playground-assets.mjs" || true
exit 0
